NODE_ENV=development
DEMO_PASSWORD=defina-uma-senha-exclusiva-apenas-para-dados-de-teste
PORT=3001

DB_HOST=localhost
DB_PORT=5432
DB_NAME=clinicalmed
DB_USER=clinicalmed_app
DB_PASSWORD=use-uma-senha-forte-e-exclusiva
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Use estas credenciais apenas nos scripts de provisionamento/migração.
# Não use o superusuário para iniciar a API.
# DB_ADMIN_USER=postgres
# DB_ADMIN_PASSWORD=senha-administrativa
# DB_MIGRATION_USER=clinicalmed_migrator
# DB_MIGRATION_PASSWORD=senha-do-migrador
# APP_DB_PASSWORD=senha-exclusiva-do-clinicalmed_app

# Gere cada segredo separadamente com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=substitua-por-um-segredo-aleatorio-de-256-bits
SESSION_ABSOLUTE_MINUTES=15
SESSION_IDLE_MINUTES=5
SESSION_MAX_CONCURRENT=3
MFA_REQUIRED_PROFILES=PACIENTE,MEDICO,SECRETARIO

DATA_ENCRYPTION_KEY_ID=2026-01
DATA_ENCRYPTION_KEY=substitua-por-uma-chave-base64url-de-32-bytes
# Durante uma rotação, mantenha temporariamente: id-antigo:chave-base64url
DATA_ENCRYPTION_PREVIOUS_KEYS=
DATA_INDEX_KEY=substitua-por-outra-chave-base64url-de-32-bytes

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://[::1]:5173,http://localhost:5174,http://127.0.0.1:5174,http://[::1]:5174
# Em produção atrás de um único proxy reverso, use 1. Nunca use true.
TRUST_PROXY=false
